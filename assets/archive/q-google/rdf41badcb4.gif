escription&quot;:null,&quot;questionsCount&quot;:1,&quot;subscribersCount&quot;:0,&quot;tag&quot;:&quot;автобетоносмесители&quot;,&quot;verificable&quot;:null,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#F2A793&quot;,&quot;id&quot;:&quot;автобетоносмесители&quot;},&quot;фасилитация&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:2,&quot;colors&quot;:null,&quot;coverId&quot;:null,&quot;description&quot;:null,&quot;questionsCount&quot;:0,&quot;subscribersCount&quot;:0,&quot;tag&quot;:&quot;фасилитация&quot;,&quot;verificable&quot;:null,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#BAD6A5&quot;,&quot;id&quot;:&quot;фасилитация&quot;},&quot;освобождающие структуры&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:2,&quot;colors&quot;:null,&quot;coverId&quot;:null,&quot;description&quot;:null,&quot;questionsCount&quot;:0,&quot;subscribersCount&quot;:0,&quot;tag&quot;:&quot;освобождающие структуры&quot;,&quot;verificable&quot;:null,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#BAD6A5&quot;,&quot;id&quot;:&quot;освобождающие структуры&quot;},&quot;психология&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:1266,&quot;colors&quot;:null,&quot;coverId&quot;:&quot;1540982/2a000001720f5947ef6e1f9fa03d603104f4&quot;,&quot;description&quot;:&quot;Психика человека, отношения с близкими и окружением, особенности поведения, детские травмы, теоретические основы и понятия — ответы на ваши психологические вопросы вам дадут профессионалы из числа экспертов Кью.&quot;,&quot;questionsCount&quot;:98642,&quot;sticker&quot;:&quot;879490/2a00000178888bf5e71f765c6b1a41c56554&quot;,&quot;subscribersCount&quot;:131352,&quot;tag&quot;:&quot;психология&quot;,&quot;verificable&quot;:true,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#BCBEE1&quot;,&quot;id&quot;:&quot;психология&quot;},&quot;общество&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:1285,&quot;colors&quot;:null,&quot;coverId&quot;:&quot;907656/2a00000176536d4544af86ee7a220baf5fbd&quot;,&quot;description&quot;:&quot;Актуальные общественные проблемы, злободневные вопросы, истории из прошлого, сходства и различия между народами и странами, благотворительность — получайте экспертные ответы от специалистов на ваши вопросы.&quot;,&quot;questionsCount&quot;:58313,&quot;sticker&quot;:&quot;1357594/2a00000178888f20e64c4356b34d8d47b94c&quot;,&quot;subscribersCount&quot;:56712,&quot;tag&quot;:&quot;общество&quot;,&quot;verificable&quot;:true,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#F2A793&quot;,&quot;id&quot;:&quot;общество&quot;},&quot;отношения&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:198,&quot;colors&quot;:null,&quot;coverId&quot;:&quot;879490/2a0000016de0853ddde39129441aa3dc8447&quot;,&quot;description&quot;:&quot;Сообщество всех! Если у вас были отношения или не было, но хотите, или не было и не хотите – но интересно, как это – здесь вы можете спросить о чужом опыте или рассказать о своём. Любовь и бережное отношение друг к другу и советы психологов. Сообщество, свободное от токсичности.&quot;,&quot;parentTag&quot;:&quot;психология&quot;,&quot;questionsCount&quot;:31302,&quot;subscribersCount&quot;:56532,&quot;tag&quot;:&quot;отношения&quot;,&quot;verificable&quot;:null,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#F8E3AC&quot;,&quot;id&quot;:&quot;отношения&quot;},&quot;кью&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:100,&quot;colors&quot;:null,&quot;coverId&quot;:null,&quot;description&quot;:null,&quot;parentTag&quot;:&quot;психология&quot;,&quot;questionsCount&quot;:402,&quot;subscribersCount&quot;:19,&quot;tag&quot;:&quot;кью&quot;,&quot;verificable&quot;:null,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#F2A793&quot;,&quot;id&quot;:&quot;кью&quot;},&quot;нью на кью&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:16,&quot;colors&quot;:null,&quot;coverId&quot;:null,&quot;description&quot;:null,&quot;questionsCount&quot;:8,&quot;subscribersCount&quot;:60,&quot;tag&quot;:&quot;нью на кью&quot;,&quot;verificable&quot;:null,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#BAD6A5&quot;,&quot;id&quot;:&quot;нью на кью&quot;},&quot;уведомления&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:1,&quot;colors&quot;:null,&quot;coverId&quot;:null,&quot;description&quot;:null,&quot;parentTag&quot;:&quot;технологии&quot;,&quot;questionsCount&quot;:406,&quot;subscribersCount&quot;:54,&quot;tag&quot;:&quot;уведомления&quot;,&quot;verificable&quot;:null,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#BCBEE1&quot;,&quot;id&quot;:&quot;уведомления&quot;},&quot;бизнес и менеджмент&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:600,&quot;colors&quot;:null,&quot;coverId&quot;:&quot;879490/2a0000017791cc103bb1757bb34e96f4c74b&quot;,&quot;description&quot;:&quot;Создание и развитие компаний, управление ими, взаимодействие бизнеса со внешней средой — ответы на ваши вопросы дадут успешные бизнесмены, предприниматели и менеджеры.&quot;,&quot;questionsCount&quot;:24147,&quot;sticker&quot;:&quot;1540982/2a00000178888fe93082f58bce72c647b407&quot;,&quot;subscribersCount&quot;:11993,&quot;tag&quot;:&quot;бизнес и менеджмент&quot;,&quot;verificable&quot;:true,&quot;type&quot;:&quot;tag&quot;,&quot;fill&quot;:&quot;#A5D3D6&quot;,&quot;id&quot;:&quot;бизнес и менеджмент&quot;},&quot;сообщества&quot;:{&quot;subscribed&quot;:false,&quot;articlesCount&quot;:50,&quot;colors&quot;:null,&quot;coverId&quot;:&quot;225226/2a00000173244dc99aac9826b780f7bb7be1&quot;,&quot;description&quot;:&quot;Сообщества – это новый (и старый) чёрный. Кью – это сообщество сообществ (если вы ещё не знали). А что же такое сообщество и как оно устроено? Как завести своё сообщество и нужно ли это вам? Зачем они нужны сегодня? Кто ими занимается? Как найти своих – и успокоиться или завоевать мир? Сообщество про сообщества на Кью – для сообществ и всех, кому это интересно.&quot;,&quot;parentTag&q